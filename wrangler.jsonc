{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japan-island-quiz",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // タイルと集計 API だけ Worker を通す。それ以外は静的アセットとして直接返す（Worker の無料枠を消費しない）
    "run_worker_first": ["/api/*", "/tiles/*"]
  },
  // base.pmtiles の置き場所（静的アセットは Range リクエストに対応していないため）
  "r2_buckets": [
    {
      "binding": "TILES",
      "bucket_name": "japan-island-quiz"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japan-island-quiz",
      "database_id": "d6f62c3f-76e4-4a90-92bb-d06279a39164"
    }
  ],
  // 集計 API のいたずら対策。教室など同じ IP から大勢が遊ぶことを考えて緩めにする
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
